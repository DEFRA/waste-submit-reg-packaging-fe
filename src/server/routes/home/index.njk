{% extends 'layouts/page.njk' %}

{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: "waste-submit-reg-packaging-fe"
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <div class="govuk-body" data-testid="app-page-body">
        <h2 class="govuk-heading-m">Backend services</h2>
        <dl class="govuk-summary-list" data-testid="service-statuses">
          {% for service in serviceStatuses %}
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">{{ service.name }}</dt>
              <dd class="govuk-summary-list__value">
                {% if service.healthy %}
                  {{ govukTag({ text: "Healthy", classes: "govuk-tag--green" }) }}
                {% else %}
                  {{ govukTag({ text: "Unavailable", classes: "govuk-tag--red" }) }}
                {% endif %}
              </dd>
            </div>
          {% endfor %}
        </dl>
      </div>
    </div>
  </div>

{% endblock %}
