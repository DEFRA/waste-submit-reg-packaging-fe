{#
  Google Tag Manager — head.

  Publishes the GTM container id and GA4 measurement id for analytics.js,
  which queues the page's controls (tag blocklist, a policy that refuses any
  tag other than this measurement id, consent defaults) and then loads
  gtm.js. Loading it from a bundled module rather than an inline snippet
  means the container never sees a CSP nonce it could pass on to scripts it
  injects.

  This template is only included when analytics is enabled and
  cookiesPolicy.analytics is true (see layouts/page.njk), so GTM never loads
  without consent.
#}

<meta name="analytics-container-id" content="{{ analyticsTag.containerId }}">
<meta name="analytics-measurement-id" content="{{ analyticsTag.measurementId }}">
<script type="module" src="{{ getAssetPath('src/client/javascripts/analytics.js') }}"></script>
